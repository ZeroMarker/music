endin

; ---------------- moon lute (plucked silk) ----------------
; p4 midi note, p5 amp, p6 pan
instr 20
  ifreq = cpsmidinn(p4)
  iamp = p5
  ipan = (p6 + 1) * 0.5
  astr wgpluck2 0.5, iamp, ifreq, 0.4, 0.6
  ; plucked-string body with a touch of the octave partial
  astr = astr + (poscil(iamp * 0.25, ifreq * 2.01) * expseg(1, 0.02, 0.4, p3, 0.001))
  astr = butterlp(astr, 4200) * linseg(1, p3 * 0.8, 1, p3 * 0.2, 0)
  aL, aR pan2 astr, ipan
  gaDryL = gaDryL + aL
  gaDryR = gaDryR + aR
  gaRevL = gaRevL + aL * 0.18
  gaRevR = gaRevR + aR * 0.18
endin

; ---------------- breath flute (xiao / bass) ----------------
; p4 midi note, p5 amp, p6 pan, p7 attack, p8 vibrato depth
instr 21
  ifreq = cpsmidinn(p4)
  iamp = p5
  ipan = (p6 + 1) * 0.5
  iatt = min(p7, p3 * 0.3)
  ivib = p8
  avib = 1 + oscili(ivib, 4.8)
  aflute = poscil(0.5, ifreq * avib) + poscil(0.14, ifreq * 2.01 * avib)
  abreath = butterbp(pinkish(0.05), ifreq * 2.4, ifreq * 1.2)
  aenv = linseg(0, iatt, 1, max(0.001, p3 - iatt - min(0.08, p3 * 0.2)), 0.75, min(0.08, p3 * 0.2), 0)
  asig = (aflute + abreath) * aenv * iamp
  asig = butterlp(asig, 4200)
  aL, aR pan2 asig, ipan
  gaDryL = gaDryL + aL
  gaDryR = gaDryR + aR
  gaRevL = gaRevL + aL * 0.2
  gaRevR = gaRevR + aR * 0.2
endin

; ---------------- erhu (singing string) ----------------
; p4 midi note, p5 amp, p6 pan
instr 22
  ifreq = cpsmidinn(p4)
  iamp = p5
  ipan = (p6 + 1) * 0.5
  avib = 1 + oscili(0.005, 5.2)
  ; two detuned bowed partials
  abow = poscil(0.4, ifreq * 0.997 * avib) + poscil(0.4, ifreq * 1.003 * avib)
  asig = butterlp(abow, limit(ifreq * 4, 900, 4200))
  iatt = min(0.1, p3 * 0.3)
  irel = min(0.1, p3 * 0.2)
  aenv = linseg(0, iatt, 1, max(0.001, p3 - iatt - irel), 0.78, irel, 0)
  asig = asig * aenv * iamp
  aL, aR pan2 asig, ipan
  gaDryL = gaDryL + aL
  gaDryR = gaDryR + aR
  gaRevL = gaRevL + aL * 0.22
  gaRevR = gaRevR + aR * 0.22
endin

; ---------------- master bus + reverb ----------------
instr 99
  aRevL, aRevR freeverb gaRevL, gaRevR, 0.85, 0.35
  aL = gaDryL + aRevL * 0.5
  aR = gaDryR + aRevR * 0.5
  kfade = linseg(1, max(0.001, p3 - min(1.5, p3 * 0.5)), 1, min(1.5, p3 * 0.5), 0)
  aL = aL * kfade
  aR = aR * kfade
  aOutL = tanh(aL)
  aOutR = tanh(aR)
  outs aOutL, aOutR
  gaDryL = 0
  gaDryR = 0
  gaRevL = 0
  gaRevR = 0
endin

</CsInstruments>
<CsScore>
; DURATION defaults to the full render length; override with
;   csound --smacro:DURATION=8 -o out.wav liangzhu/main.csd
#ifndef DURATION
#define DURATION #128#
#end
i 1 0 $DURATION
i 99 0 $DURATION
e
</CsScore>
