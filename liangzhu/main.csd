    schedule 20, 117.500000, min(0.291667, p3 - 117.500000), 62, 0.0497, -0.18
  endif
  if (p3 > 118.333333) then
    schedule 21, 118.333333, min(1.416667, p3 - 118.333333), 33, 0.0507, -0.22, 0.18, 0.003
  endif
  if (p3 > 118.333333) then
    schedule 20, 118.333333, min(0.291667, p3 - 118.333333), 57, 0.0447, -0.18
  endif
  if (p3 > 118.333333) then
    schedule 21, 118.333333, min(0.916667, p3 - 118.333333), 64, 0.0537, 0.25, 0.12, 0.004
  endif
  if (p3 > 118.333333) then
    schedule 22, 118.333333, min(1.500000, p3 - 118.333333), 62, 0.0596, 0.08
  endif
  if (p3 > 119.166667) then
    schedule 20, 119.166667, min(0.291667, p3 - 119.166667), 64, 0.0447, -0.18
  endif
