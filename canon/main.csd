; ---------------- soft piano ----------------
; p4 midi note, p5 amp, p6 pan (-1 left, +1 right)
instr 10
  ifreq = cpsmidinn(p4)
  iamp = p5
  ipan = (p6 + 1) * 0.5
  ; hammer transient (filtered noise)
  aclick = butterbp(rand(0.8), 2500, 1400)
  aclick = aclick * expseg(1, 0.005, 0.001, 0.04, 0.0001)
  ; inharmonic string body
  abody = poscil(0.55, ifreq) + poscil(0.24, ifreq * 1.997) + poscil(0.13, ifreq * 3.01)
  iatt = min(0.004, p3 * 0.1)
  idec = min(0.25, p3 * 0.3)
  aenv = expseg(0.001, iatt, 1, idec, 0.4, max(0.001, p3 - iatt - idec), 0.0001)
  asig = (abody * aenv + aclick * 0.9) * iamp
  asig = butterlp(asig, 4200)
  aL, aR pan2 asig, ipan
  gaDryL = gaDryL + aL
  gaDryR = gaDryR + aR
  gaRevL = gaRevL + aL * 0.25
  gaRevR = gaRevR + aR * 0.25
endin

; ---------------- bowed string ----------------
; p4 midi note, p5 amp, p6 pan (-1 left, +1 right), p7 attack,
; p8 bright, p9 body resonance, p10 vibrato
instr 11
  ifreq = cpsmidinn(p4)
  iamp = p5
  ipan = (p6 + 1) * 0.5
  ; Keep the release segment valid for truncated smoke-test notes.
  iatt = min(p7, p3 * 0.35)
  irel = min(0.06, p3 * 0.2)
  ibright = p8
  ibody = p9
  ivib = p10
  asig wgbow iamp * 1.5, ifreq, 1.0, 0.5, 5.1, ivib, giSine, 60
  acut = limit(ifreq * (3.0 + ibright), 900, 5200)
  asig = butterlp(asig, acut)
  ares = butterbp(asig, ibody, ibody * 0.3) * 0.16
  asig = asig + ares
  aenv = linseg(0, iatt, 1, max(0.001, p3 - iatt - irel), 0.72, irel, 0)
  asig = asig * aenv
  aL, aR pan2 asig, ipan
  gaDryL = gaDryL + aL
  gaDryR = gaDryR + aR
  gaRevL = gaRevL + aL * 0.22
  gaRevR = gaRevR + aR * 0.22
endin

; ---------------- master bus + reverb ----------------
instr 99
  aRevL, aRevR freeverb gaRevL, gaRevR, 0.78, 0.4
  aL = (gaDryL + aRevL * 0.55) * 1.5
  aR = (gaDryR + aRevR * 0.55) * 1.5
  ; gentle master fade over the last 1.5 s
  kfade = linseg(1, max(0.001, p3 - min(1.5, p3 * 0.5)), 1, min(1.5, p3 * 0.5), 0)
  aL = aL * kfade
  aR = aR * kfade
  aOutL = tanh(aL)
  aOutR = tanh(aR)
  outs aOutL, aOutR
  gaDryL = 0
  gaDryR = 0
  gaRevL = 0
  gaRevR = 0
endin

</CsInstruments>
<CsScore>
; DURATION defaults to the full render length; override with
;   csound --smacro:DURATION=8 -o out.wav canon/main.csd
#ifndef DURATION
#define DURATION #137.2#
#end
i 1 0 $DURATION
i 99 0 $DURATION
e
</CsScore>
</CsoundSynthesizer>
